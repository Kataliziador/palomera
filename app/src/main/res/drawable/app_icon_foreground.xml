<!--
  El símbolo, dentro de la zona segura de 66 dp del icono adaptativo.

  La tinta del símbolo mide 53 x 49 con el centro en (35,36) — las mismas
  coordenadas que en `app_logo.xml`, para que no haya dos dibujos que se
  puedan desincronizar—. Su diagonal es 72, y la zona segura es un círculo de
  66: de ahí el 0.88, que la deja en 63.5 y cabe. El `pivot` va en ese centro,
  así que la traslación es la diferencia hasta el centro del lienzo.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group
        android:pivotX="35" android:pivotY="36"
        android:scaleX="0.88" android:scaleY="0.88"
        android:translateX="19" android:translateY="18">
    <path
        android:pathData="M14,33 L21,57 L49,57 L56,33"
        android:strokeColor="#F4F5F7"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M16.5,41 L53.5,41"
        android:strokeColor="#F4F5F7"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M12,34 A8.5,8.5 0 0 1 27,28 A11,11 0 0 1 44,26 A8.5,8.5 0 0 1 58,34"
        android:strokeColor="#F4F5F7"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    </group>
</vector>
