<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools" >
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" >
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>

    <!--
      El registro de sites, **nunca en claro**.

      La app permite tráfico sin cifrar de forma global porque lo necesitan el
      Jellyfin y los streams del ISP, que viven en su LAN. Eso significa que
      nada impediría por accidente un `http://` hacia el registro, y ése sí va
      por internet: lo pedía el proyecto del autorizador en `PETICION_APK` §1.

      **Solo surte efecto desde API 24**, así que no sustituye a nada — el
      `RegistryTrust` del módulo es lo que hace el trabajo de verdad, y encima
      cubre las cajas viejas, que es donde Android ignora este archivo.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">authjelly.satmx.net</domain>
    </domain-config>
</network-security-config>
