<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="48dp"
    android:layout_marginVertical="27dp"
    tools:context=".ui.startup.StartupActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        style="@style/TextAppearance.Leanback.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/livetv_servidor_titulo"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      El selector de proveedor (docs/selector-de-proveedor.md). Las tres rutas
      comparten pantalla y se encienden por turnos: primero se pregunta al
      registro por la IP, y según lo que conteste se enseña el proveedor
      reconocido o el campo del código. La dirección a mano **no se esconde
      nunca**: es la única que funciona sin internet, y es por donde entra el
      revisor de Google (PLAY.md §6).
    -->
    <TextView
        android:id="@+id/proveedor_estado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/livetv_proveedor_buscando"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <Button
        android:id="@+id/proveedor_confirmar"
        style="@style/Button.Default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/livetv_proveedor_confirmar"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/proveedor_estado"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/codigo"
        style="@style/Input.Default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/livetv_proveedor_codigo_ejemplo"
        android:imeOptions="actionDone"
        android:inputType="textCapCharacters"
        android:nextFocusDown="@id/codigo_confirmar"
        android:nextFocusForward="@id/codigo_confirmar"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/proveedor_confirmar"
        tools:visibility="visible" />

    <Button
        android:id="@+id/codigo_confirmar"
        style="@style/Button.Default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/livetv_proveedor_codigo_accion"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codigo"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/manual_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/livetv_servidor_manual"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/codigo_confirmar" />

    <TextView
        android:id="@+id/address_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/livetv_servidor_ayuda"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/manual_titulo" />

    <EditText
        android:id="@+id/address"
        style="@style/Input.Default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:imeOptions="actionDone"
        android:inputType="textUri"
        android:nextFocusDown="@id/confirm"
        android:nextFocusForward="@id/confirm"
        android:privateImeOptions="horizontalAlignment=right"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address_label" />

    <Button
        android:id="@+id/confirm"
        style="@style/Button.Default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/action_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/address" />

    <TextView
        android:id="@+id/error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@id/center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/confirm"
        tools:text="@string/server_connecting" />
</androidx.constraintlayout.widget.ConstraintLayout>
