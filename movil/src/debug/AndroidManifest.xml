<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      **Sólo en depuración, y nunca viaja.** La medición del entrelazado
      (R1 de `MOVIL_PLAN.md`) pasa por un puente HTTP en el propio teléfono,
      tunelizado con `adb reverse` porque el aparato de pruebas está en otra
      subred y no alcanza el headend.

      Android bloquea el tráfico en claro desde `targetSdk 28`, así que sin
      esto el reproductor no podría abrir ni `http://127.0.0.1`.

      Lo que la app de verdad necesite para hablar con la LAN del ISP se
      decidirá aparte, con su `network_security_config`, como ya hace `app/`.
    -->
    <application android:usesCleartextTraffic="true" />
</manifest>
